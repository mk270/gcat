#!/usr/bin/env python3

import email.message
import os
import socket
import ssl
import sys
import urllib.parse
import signal
import time
import logging
import argparse
import io
from types import FrameType
from typing import List, NamedTuple, NoReturn, Tuple

DEFAULT_TIMEOUT = 5

def timeout(signum: int, frame: FrameType | None) -> NoReturn:
    sys.exit(99)

def absolutise_url(base: str, relative: str) -> str:
    # Absolutise relative links
    if "://" not in relative:
        # Python's URL tools somehow only work with known schemes?
        base = base.replace("gemini://","http://")
        relative = urllib.parse.urljoin(base, relative)
        relative = relative.replace("http://", "gemini://")
    return relative


class TruncatedError(Exception):
    """The connection ended without a TLS close_notify.

    The data received before that point is in .partial.
    """
    def __init__(self, partial: bytes = b"") -> None:
        super().__init__("connection closed without TLS close_notify")
        self.partial = partial


def read_header(fp: io.BufferedReader) -> bytes:
    try:
        return fp.readline()
    except ssl.SSLEOFError as e:
        raise TruncatedError() from e


def read_all(fp: io.BufferedReader) -> bytes:
    chunks: List[bytes] = []

    try:
        while chunk := fp.read1(65536):
            chunks.append(chunk)
    except ssl.SSLEOFError as e:
        raise TruncatedError(b"".join(chunks)) from e
    return b"".join(chunks)


def print_body(raw_body: bytes, meta: str) -> None:
    if meta.startswith("text/"):
        # Decode according to the charset declared in the meta line
        m = email.message.Message()
        m["Content-Type"] = meta
        charset = m.get_content_charset() or "UTF-8"
        try:
            text = raw_body.decode(charset)
        except LookupError:
            print("gcat: warning: unknown charset %r; assuming UTF-8"
                  % charset, file=sys.stderr)
            text = raw_body.decode("UTF-8", errors="replace")
        print(text, end="")
    else:
        print(raw_body, end="")


def show_response(fp: io.BufferedReader, meta: str) -> None:
    """Read the body and print it; on truncation, print what arrived."""
    try:
        raw_body = read_all(fp)
    except TruncatedError as e:
        # show what did arrive, then let the caller report it
        print_body(e.partial, meta)
        raise
    print_body(raw_body, meta)


def normalise_url(raw: str) -> str:
    """Add a missing scheme; exit 1 if the URL isn't a gemini one."""
    url = raw
    parsed_url = urllib.parse.urlparse(url)
    if parsed_url.scheme == "":
        url = "gemini://"+url
        parsed_url = urllib.parse.urlparse(url)

    if parsed_url.scheme != "gemini":
        print("Sorry, Gemini links only.")
        sys.exit(1)
    return url


# How long to wait for the peer while shutting a connection down
CLOSE_TIMEOUT = 1.0


class Connection:
    """A TLS connection and a buffered reader over it.

    close() sends a TLS close_notify before releasing the socket, so
    the peer can tell a deliberate hang-up from a truncated stream.
    Usable as a context manager.
    """
    def __init__(self, sock: ssl.SSLSocket) -> None:
        self.sock = sock
        self.fp = sock.makefile("rb")

    def close(self) -> None:
        try:
            self.sock.settimeout(CLOSE_TIMEOUT)
            self.sock.unwrap()
        except OSError:
            # includes ssl.SSLError; the peer may have gone already
            pass
        finally:
            self.fp.close()
            self.sock.close()

    def __enter__(self) -> "Connection":
        return self

    def __exit__(self, *exc_info: object) -> None:
        self.close()


class Response(NamedTuple):
    """The final outcome of a transaction; the caller closes conn."""
    conn: Connection
    status: str
    meta: str


def open_request(url: str) -> Connection:
    """Connect and send the request line."""
    parsed_url = urllib.parse.urlparse(url)
    if parsed_url.port is not None:
        useport = parsed_url.port
    else:
        useport = 1965
    s = socket.create_connection((parsed_url.hostname, useport))
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    # Don't let ssl turn a missing close_notify into a plain EOF
    s = context.wrap_socket(s, server_hostname = parsed_url.hostname,
                            suppress_ragged_eofs = False)
    s.sendall((url + '\r\n').encode("UTF-8"))
    return Connection(s)


def parse_header(raw_header: bytes) -> Tuple[str, str]:
    """Split a response header line into (status, meta)."""
    header = raw_header.decode("UTF-8").strip()
    status, meta = header.split(None, 1)
    return status, meta


def transact(url: str, quiet: bool) -> Response:
    """Do the Gemini transaction, answering prompts and following
    redirects; return the final response.  The caller must close its
    connection."""
    while True:
        # Get header and check for redirects
        conn = open_request(url)
        try:
            raw_header = read_header(conn.fp)
            if not quiet:
                print(raw_header.decode("UTF-8"), end="")

            status, meta = parse_header(raw_header)
        except Exception:
            conn.close()
            raise
        # Handle input requests
        if status.startswith("1"):
            # Prompt
            conn.close()
            try:
                query = input("INPUT" + meta + "> ")
            except EOFError:
                print("\ngcat: server requested input, but stdin is at "
                      "end of file", file=sys.stderr)
                sys.exit(3)
            url += "?" + urllib.parse.quote(query) # Bit lazy...
        # Follow redirects
        elif status.startswith("3"):
            conn.close()
            url = absolutise_url(url, meta)
        # Otherwise, we're done.
        else:
            return Response(conn, status, meta)


def main(args: argparse.Namespace) -> None:
    signal.signal(signal.SIGALRM, timeout)
    signal.alarm(args.timeout)

    url = normalise_url(args.url)
    response = transact(url, args.quiet)
    with response.conn:
        # Fail if transaction was not successful
        if response.status.startswith("2"):
            show_response(response.conn.fp, response.meta)

def parse_cmdline() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument('-q', '--quiet', action='store_true',
                        required=False,
                        help='Suppress printing header info')
    parser.add_argument('-d', '--debug', action='store_true', required=False,
                    help='set logging level to INFO')
    parser.add_argument('url',
                        help='URL to download from')
    parser.add_argument('--timeout', type=int,
                        default=DEFAULT_TIMEOUT,
                        help='timeout, in seconds')

    args = parser.parse_args()
    if args.debug:
        logging.getLogger().setLevel(20)
    try:
        main(args)
    except TruncatedError:
        print("gcat: warning: connection closed without TLS close_notify; "
              "response may be truncated", file=sys.stderr)
        sys.exit(2)

if __name__ == '__main__':
    parse_cmdline()
