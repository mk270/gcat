#!/usr/bin/env python3

# gcat, based on Solderpunk's origin gcat, and distributable under the same
# terms
#
# This version of the code is slightly more aware of TLS close notification
# issues, and UTF-8 decoding woes
#
# Streaming responses is supported

import email.message
import os
import socket
import ssl
import sys
import urllib.parse
import signal
import time
import logging
import argparse
import io
import codecs
import contextlib
from types import FrameType
from typing import Callable, Iterator, NoReturn, Optional, Tuple

DEFAULT_TIMEOUT = 5

def timeout(signum: int, frame: FrameType | None) -> NoReturn:
    sys.exit(99)

def absolutise_url(base: str, relative: str) -> str:
    """Resolve a link, as found in a redirect, against the URL it came from.

    A link that already has a scheme is returned unchanged.
    """
    if "://" not in relative:
        # Python's URL tools somehow only work with known schemes?
        base = base.replace("gemini://","http://")
        relative = urllib.parse.urljoin(base, relative)
        relative = relative.replace("http://", "gemini://")
    return relative


class GeminiError(Exception):
    """Base class for the errors gcat reports.

    exit_status is the status the command line exits with, and
    cli_format how it words the message (given str(self)) on stderr.
    """
    exit_status = 1
    cli_format = "gcat: error: %s"


class TruncatedError(GeminiError):
    """The connection ended without a TLS close_notify."""
    exit_status = 2
    cli_format = "gcat: warning: %s; response may be truncated"

    def __init__(self, message: str =
                 "connection closed without TLS close_notify") -> None:
        super().__init__(message)


class InputError(GeminiError):
    """The server asked for input and none could be supplied."""
    exit_status = 3
    # starts a new line, as the prompt will have left the cursor mid-line
    cli_format = "\ngcat: %s"


class UrlError(GeminiError):
    """The URL can't be fetched by gcat."""
    cli_format = "%s"


class HeaderError(GeminiError):
    """The response header was missing or malformed."""
    exit_status = 5


def read_header(fp: io.BufferedReader) -> bytes:
    """Read the response header line, including its line ending.

    The result is empty if the server closed the connection cleanly
    without sending anything.  Raise TruncatedError if the connection
    ended without a TLS close_notify before the line was complete.
    """
    try:
        return fp.readline()
    except ssl.SSLEOFError as e:
        raise TruncatedError() from e


def read_chunks(fp: io.BufferedReader) -> Iterator[bytes]:
    """Yield the body as it arrives; raise TruncatedError if it is cut
    off without a close_notify."""
    try:
        while chunk := fp.read1(65536):
            yield chunk
    except ssl.SSLEOFError as e:
        raise TruncatedError() from e


class DecodeError(GeminiError):
    """A text body could not be decoded."""
    exit_status = 4
    cli_format = "gcat: error: %s (see --lenient)"


class TextDecoder:
    """Decode a text body incrementally.

    Raise DecodeError if the charset is unknown or the body is not
    valid in it.  If lenient, call warn(message) instead, falling back
    to UTF-8 for an unknown charset and replacing any invalid bytes.
    """
    def __init__(self, charset: str, lenient: bool,
                 warn: Callable[[str], None]) -> None:
        self.charset = charset
        self._warn = warn
        try:
            factory = codecs.getincrementaldecoder(charset)
        except LookupError as e:
            if not lenient:
                raise DecodeError("unknown charset %r" % charset) from e
            warn("unknown charset %r; assuming UTF-8" % charset)
            self.charset = "UTF-8"
            factory = codecs.getincrementaldecoder("UTF-8")
        errors = self._register_replace() if lenient else "strict"
        self._decoder = factory(errors)

    def _register_replace(self) -> str:
        """Register an error handler that warns once, then replaces."""
        warned = False

        def handler(exc: UnicodeError) -> Tuple[str, int]:
            nonlocal warned
            if not warned:
                warned = True
                self._warn("body is not valid %s; replacing bad bytes"
                           % self.charset)
            assert isinstance(exc, UnicodeDecodeError)
            return "\ufffd", exc.end

        name = "gcat-replace-%d" % id(handler)
        codecs.register_error(name, handler)
        return name

    def decode(self, data: bytes, final: bool = False) -> str:
        try:
            return self._decoder.decode(data, final)
        except UnicodeDecodeError as e:
            raise DecodeError("body is not valid %s" % self.charset) from e

    def finish_truncated(self) -> str:
        """Flush after a cut-off body, which may end mid-character."""
        self._decoder.errors = "replace"
        return self._decoder.decode(b"", True)


def meta_charset(meta: str) -> str:
    """The charset declared in a meta line; UTF-8 if there isn't one."""
    m = email.message.Message()
    m["Content-Type"] = meta
    return m.get_content_charset() or "UTF-8"


def normalise_url(raw: str) -> str:
    """Add a missing scheme; raise UrlError if it isn't a gemini URL."""
    url = raw
    parsed_url = urllib.parse.urlparse(url)
    if parsed_url.scheme == "":
        url = "gemini://"+url
        parsed_url = urllib.parse.urlparse(url)

    if parsed_url.scheme != "gemini":
        raise UrlError("Sorry, Gemini links only.")
    return url


# How long to wait for the peer while shutting a connection down
CLOSE_TIMEOUT = 1.0


class Connection:
    """A TLS connection and a buffered reader over it.

    close() sends a TLS close_notify before releasing the socket, so
    the peer can tell a deliberate hang-up from a truncated stream.
    Usable as a context manager.
    """
    def __init__(self, sock: ssl.SSLSocket) -> None:
        self.sock = sock
        self.fp = sock.makefile("rb")

    def close(self) -> None:
        try:
            self.sock.settimeout(CLOSE_TIMEOUT)
            self.sock.unwrap()
        except OSError:
            # includes ssl.SSLError; the peer may have gone already
            pass
        finally:
            self.fp.close()
            self.sock.close()

    def __enter__(self) -> "Connection":
        return self

    def __exit__(self, *exc_info: object) -> None:
        self.close()


class Response:
    """The final outcome of a request.

    The body is read with chunks() or text_chunks(), and the caller
    closes the response, which is also a context manager.
    """
    def __init__(self, conn: Connection, status: str, meta: str,
                 lenient: bool = False,
                 on_warning: Optional[Callable[[str], None]] = None) -> None:
        self.conn = conn
        self.status = status
        self.meta = meta
        self.lenient = lenient
        self.on_warning = on_warning

    @property
    def is_text(self) -> bool:
        return self.meta.startswith("text/")

    def chunks(self) -> Iterator[bytes]:
        """The body as it arrives; see read_chunks."""
        return read_chunks(self.conn.fp)

    def text_chunks(self) -> Iterator[str]:
        """The body decoded as text, as it arrives.

        Decoding follows the charset in the meta line, and the response's
        lenient setting.  If the body is truncated, what arrived is
        yielded first, a dangling half-character replaced, and then
        TruncatedError is raised.
        """
        text = TextDecoder(meta_charset(self.meta), self.lenient,
                           self.on_warning or (lambda message: None))
        try:
            for chunk in self.chunks():
                yield text.decode(chunk)
        except TruncatedError:
            yield text.finish_truncated()
            raise
        yield text.decode(b"", final=True)

    def close(self) -> None:
        self.conn.close()

    def __enter__(self) -> "Response":
        return self

    def __exit__(self, *exc_info: object) -> None:
        self.close()


def open_request(url: str) -> Connection:
    """Connect and send the request line."""
    parsed_url = urllib.parse.urlparse(url)
    if parsed_url.port is not None:
        useport = parsed_url.port
    else:
        useport = 1965
    s = socket.create_connection((parsed_url.hostname, useport))
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    # Don't let ssl turn a missing close_notify into a plain EOF
    s = context.wrap_socket(s, server_hostname = parsed_url.hostname,
                            suppress_ragged_eofs = False)
    s.sendall((url + '\r\n').encode("UTF-8"))
    return Connection(s)


def parse_header(raw_header: bytes) -> Tuple[str, str]:
    """Split a response header line into (status, meta).

    Raise HeaderError if the header is empty, or does not consist of a
    status and a meta field.
    """
    header = raw_header.decode("UTF-8").strip()
    if not header:
        raise HeaderError("server sent no response header")
    fields = header.split(None, 1)
    if len(fields) != 2:
        raise HeaderError("malformed response header: %r" % header)
    return fields[0], fields[1]


class GeminiClient:
    """Make Gemini requests, answering prompts and following redirects.

    The client does no I/O of its own beyond the connection.  Callers
    supply hooks for the rest:

    on_input(prompt) -> answer
        Called when the server asks for input.  Raise InputError if
        there is no answer; without this hook a prompt is an error.
    on_header(line)
        Called with every response header line as received, before it
        is parsed, so with each redirect and prompt on the way too.
    on_warning(message)
        Called instead of failing, when lenient, about a text body that
        can't be decoded properly.  Without it such warnings are dropped.

    If lenient is false, a text body that can't be decoded is a
    DecodeError.
    """
    def __init__(self,
                 lenient: bool = False,
                 on_input: Optional[Callable[[str], str]] = None,
                 on_header: Optional[Callable[[str], None]] = None,
                 on_warning: Optional[Callable[[str], None]] = None) -> None:
        self.lenient = lenient
        self.on_input = on_input
        self.on_header = on_header
        self.on_warning = on_warning

    def request(self, url: str) -> Response:
        """Fetch url; the caller must close the response's connection."""
        url = normalise_url(url)
        while True:
            # Get header and check for redirects
            conn = open_request(url)
            try:
                raw_header = read_header(conn.fp)
                if self.on_header:
                    self.on_header(raw_header.decode("UTF-8"))

                status, meta = parse_header(raw_header)
            except Exception:
                conn.close()
                raise
            # Handle input requests
            if status.startswith("1"):
                # Prompt
                conn.close()
                if not self.on_input:
                    raise InputError("server requested input: %s" % meta)
                query = self.on_input(meta)
                url += "?" + urllib.parse.quote(query) # Bit lazy...
            # Follow redirects
            elif status.startswith("3"):
                conn.close()
                url = absolutise_url(url, meta)
            # Otherwise, we're done.
            else:
                return Response(conn, status, meta, self.lenient,
                                self.on_warning)


@contextlib.contextmanager
def alarm_paused() -> Iterator[None]:
    """Stop the SIGALRM timer while waiting for the user, then resume it
    with the time that was left, so the timeout only counts our own work."""
    remaining = signal.alarm(0)
    try:
        yield
    finally:
        if remaining:
            signal.alarm(remaining)


def cli_input(prompt: str) -> str:
    """Answer a prompt from the server by asking the user."""
    try:
        with alarm_paused():
            return input("INPUT " + prompt + "> ")
    except EOFError as e:
        raise InputError("server requested input, but stdin is at "
                         "end of file") from e


def cli_header(line: str) -> None:
    print(line, end="")


def cli_warning(message: str) -> None:
    print("gcat: warning: %s" % message, file=sys.stderr)


def write_response(response: Response) -> None:
    """Write the body to stdout as it arrives, flushing each chunk.

    Text is decoded by its declared charset; anything else is written
    as raw bytes.  On truncation, what arrived has already been written.
    """
    out = sys.stdout
    if response.is_text:
        for text in response.text_chunks():
            out.write(text)
            out.flush()
    else:
        out.flush()
        try:
            for chunk in response.chunks():
                out.buffer.write(chunk)
                out.buffer.flush()
        finally:
            out.buffer.flush()


def main(args: argparse.Namespace) -> None:
    signal.signal(signal.SIGALRM, timeout)
    signal.alarm(args.timeout)

    client = GeminiClient(lenient=args.lenient, on_input=cli_input,
                          on_header=None if args.quiet else cli_header,
                          on_warning=cli_warning)
    with client.request(args.url) as response:
        # Fail if transaction was not successful
        if response.status.startswith("2"):
            write_response(response)

def parse_cmdline() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument('-q', '--quiet', action='store_true',
                        required=False,
                        help='Suppress printing header info')
    parser.add_argument('-d', '--debug', action='store_true', required=False,
                    help='set logging level to INFO')
    parser.add_argument('url',
                        help='URL to download from')
    parser.add_argument('--lenient', action='store_true',
                        help='warn about, rather than fail on, a body that '
                        'cannot be decoded')
    parser.add_argument('--timeout', type=int,
                        default=DEFAULT_TIMEOUT,
                        help='timeout, in seconds')

    args = parser.parse_args()
    if args.debug:
        logging.getLogger().setLevel(20)
    try:
        main(args)
    except GeminiError as e:
        print(e.cli_format % e, file=sys.stderr)
        sys.exit(e.exit_status)

if __name__ == '__main__':
    parse_cmdline()
